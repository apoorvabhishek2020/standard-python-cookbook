{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "strict",
  "files.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pyright": true,
    "**/.pytest_cache": true,
    "**/.hypothesis": true,
    "**/htmlcov": true,
    "**/.coverage": true,
    "**/.coverage.*": true,
    "**/mutants": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pyright": true,
    "**/.pytest_cache": true,
    "**/.hypothesis": true,
    "**/htmlcov": true,
    "**/mutants": true,
    "**/.venv": true,
    "**/uv.lock": true
  }
}
